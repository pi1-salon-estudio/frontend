# URL base de la API (backend-api).
# En local apunta al backend corriendo en tu máquina; en Vercel se configura
# como variable de entorno del proyecto con la URL de Render.
# Ojo: todo lo que empieza por VITE_ queda visible en el navegador. Nunca pongas llaves aquí.
VITE_API_URL=http://localhost:3000

# Configuración pública de Firebase Authentication (ajustes del proyecto en la consola).
# No es una llave secreta: el navegador la necesita para iniciar sesión.
# Pídele los tres valores a quien administra Firebase y no subas el .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
